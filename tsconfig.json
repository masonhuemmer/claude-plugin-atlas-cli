{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "typeRoots": ["./.claude-plugin/types"],
    "skipLibCheck": true
  },
  "include": ["hooks/**/*.ts", "tests/**/*.ts", ".claude-plugin/types/**/*.d.ts"]
}
